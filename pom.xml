<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nekkora</groupId>
  <artifactId>nekkora-agent</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>Nekkora Agent</name>
  <description>Aplicativo desktop do Nekkora Agent (AGENT-001): janela compacta, bandeja, instância única, configuração local e diagnóstico.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Bibliotecas visuais: construídas por tools/prepare-design-system.ps1 (design-system.properties). -->
    <nekkora.design-system.version>1.0.0-SNAPSHOT</nekkora.design-system.version>
    <!-- Mesma versão do Studio no commit fixado (o POM pai do Studio a gerencia; aqui só a tornamos explícita). -->
    <flatlaf.version>3.7.2</flatlaf.version>
    <junit.version>5.11.4</junit.version>
    <!-- AGENT-PLATFORM-001: DPAPI do Windows para o segredo da máquina (só no módulo de transporte). -->
    <jna.version>5.17.0</jna.version>
    <!-- Mesma versão usada nos testes da Extensão. -->
    <json-schema-validator.version>1.5.9</json-schema-validator.version>
    <agent.main>com.nekkora.agent.AgentMain</agent.main>
    <!-- Os testes de desktop real rodam só no perfil "desktop" (janela, bandeja e Robot). -->
    <agent.test.excludedGroups>desktop</agent.test.excludedGroups>
    <agent.test.headless>true</agent.test.headless>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-swing-ui</artifactId>
      <version>${nekkora.design-system.version}</version>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-design-tokens</artifactId>
      <version>${nekkora.design-system.version}</version>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna-platform</artifactId>
      <version>${jna.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Só nos testes: validador independente do JSON Schema publicado (A01). Não entra no ZIP. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>com/nekkora/agent/agent-build.properties</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>com/nekkora/agent/agent-build.properties</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- Lê design-system.properties para registrar a origem das bibliotecas no build. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>properties-maven-plugin</artifactId>
        <version>1.2.1</version>
        <executions>
          <execution>
            <phase>initialize</phase>
            <goals><goal>read-project-properties</goal></goals>
            <configuration>
              <files>
                <file>${project.basedir}/design-system.properties</file>
              </files>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>9.0.1</version>
        <executions>
          <execution>
            <id>build-commit</id>
            <phase>initialize</phase>
            <goals><goal>revision</goal></goals>
          </execution>
        </executions>
        <configuration>
          <failOnNoGitDirectory>false</failOnNoGitDirectory>
          <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
          <generateGitPropertiesFile>false</generateGitPropertiesFile>
          <dateFormat>yyyy-MM-dd'T'HH:mm:ssXXX</dateFormat>
          <dateFormatTimeZone>UTC</dateFormatTimeZone>
          <abbrevLength>12</abbrevLength>
          <includeOnlyProperties>
            <includeOnlyProperty>^git.commit.id$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
            <includeOnlyProperty>^git.dirty$</includeOnlyProperty>
          </includeOnlyProperties>
          <injectAllReactorProjects>false</injectAllReactorProjects>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <propertiesEncoding>UTF-8</propertiesEncoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-serial,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <excludedGroups>${agent.test.excludedGroups}</excludedGroups>
          <systemPropertyVariables>
            <java.awt.headless>${agent.test.headless}</java.awt.headless>
            <agent.basedir>${project.basedir}</agent.basedir>
            <java.util.prefs.PreferencesFactory>com.nekkora.agent.storage.IsolatedPreferencesFactory</java.util.prefs.PreferencesFactory>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <finalName>nekkora-agent</finalName>
          <archive>
            <manifest>
              <mainClass>${agent.main}</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
            <manifestEntries>
              <Implementation-Title>Nekkora Agent</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-libs</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Testes de desktop real (Windows): ./mvnw -Pdesktop verify -->
      <id>desktop</id>
      <properties>
        <agent.test.excludedGroups>none</agent.test.excludedGroups>
        <agent.test.headless>false</agent.test.headless>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- só nos testes de desktop: o A13 lista os javax.swing.Timer ativos com a janela oculta -->
              <argLine>--add-opens java.desktop/javax.swing=ALL-UNNAMED</argLine>
            </configuration>
            <executions>
              <!-- A12: a escala do Java2D só pode ser escolhida ao iniciar a JVM: uma execução por escala -->
              <execution>
                <id>scale-150</id>
                <goals><goal>test</goal></goals>
                <configuration>
                  <test>ScaleEvidenceTest</test>
                  <reportNameSuffix>scale150</reportNameSuffix>
                  <argLine>-Dsun.java2d.uiScale=1.5</argLine>
                </configuration>
              </execution>
              <execution>
                <id>scale-200</id>
                <goals><goal>test</goal></goals>
                <configuration>
                  <test>ScaleEvidenceTest</test>
                  <reportNameSuffix>scale200</reportNameSuffix>
                  <argLine>-Dsun.java2d.uiScale=2.0</argLine>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
